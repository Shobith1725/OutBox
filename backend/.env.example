# ═══════════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════════
DATABASE_URL="postgresql://outbox:outbox_secret@localhost:5432/outbox_db?schema=public"

# ═══════════════════════════════════════════════════
# Redis
# ═══════════════════════════════════════════════════
REDIS_URL="redis://localhost:6379"

# ═══════════════════════════════════════════════════
# Elasticsearch
# ═══════════════════════════════════════════════════
ELASTICSEARCH_URL="http://localhost:9200"

# ═══════════════════════════════════════════════════
# Server
# ═══════════════════════════════════════════════════
PORT=4000
FRONTEND_URL="http://localhost:3000"
SESSION_SECRET="change-me-to-a-random-secret-string"

# ═══════════════════════════════════════════════════
# Google OAuth
# ═══════════════════════════════════════════════════
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# ═══════════════════════════════════════════════════
# Slack OAuth
# ═══════════════════════════════════════════════════
SLACK_CLIENT_ID="your-slack-client-id"
SLACK_CLIENT_SECRET="your-slack-client-secret"
SLACK_REDIRECT_URI="http://localhost:4000/integrations/slack/callback"

# ═══════════════════════════════════════════════════
# Worker / Scheduling Config
# ═══════════════════════════════════════════════════
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# ═══════════════════════════════════════════════════
# Bull-Board Admin Auth (basic auth)
# ═══════════════════════════════════════════════════
BULL_BOARD_USER="admin"
BULL_BOARD_PASS="admin"
